# ===================================================================
# POS & Billing System - Environment Variables Template
# Copy this file to backend/.env, POSUI/.env, and OpenWA/.env respectively.
# ===================================================================

# -------------------------------------------------------------------
# Backend (NestJS + Prisma + PostgreSQL - Port 4000)
# -------------------------------------------------------------------
NODE_ENV=development
PORT=4000
DATABASE_URL=postgresql://postgres:root@localhost:5432/pos_billing_db?schema=public
TEST_DATABASE_URL=postgresql://postgres:root@localhost:5433/pos_test?schema=public

JWT_ACCESS_SECRET=change-me-min-32-chars-random-access-secret-key-12345
JWT_REFRESH_SECRET=change-me-different-min-32-chars-random-refresh-secret-key-67890
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

COOKIE_DOMAIN=localhost
COOKIE_SECURE=false
CORS_ORIGINS=http://localhost:3000

GOOGLE_CLIENT_ID=your-google-oauth-client-id
ALLOW_SELF_SIGNUP=false

OPENWA_API_URL=http://localhost:2785
OPENWA_API_KEY=sample_openwa_server_secret_key
OPENWA_SESSION_ID=default

THROTTLE_TTL_SECONDS=60
THROTTLE_LIMIT=100
LOG_LEVEL=info
APP_TIMEZONE=Asia/Kolkata
FY_START_MONTH=4

SEED_ADMIN_PASSWORD=Admin@Pass123
SEED_CASHIER_PASSWORD=Cashier@Pass123
SEED_INVENTORY_PASSWORD=Inventory@Pass123

# -------------------------------------------------------------------
# POSUI (React Frontend - Port 3000)
# -------------------------------------------------------------------
REACT_APP_API_URL=http://localhost:4000/api/v1
REACT_APP_GOOGLE_CLIENT_ID=your-google-oauth-client-id

# -------------------------------------------------------------------
# OpenWA (NestJS WhatsApp Gateway - Port 2785 / 2886)
# -------------------------------------------------------------------
OPENWA_PORT=2785
OPENWA_DASHBOARD_PORT=2886
OPENWA_API_SECRET=sample_openwa_server_secret_key
WHATSAPP_SESSION_NAME=pos_whatsapp_session
RATE_LIMIT_DELAY_MS=1500
