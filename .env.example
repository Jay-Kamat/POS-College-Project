# ===================================================================
# POS & Billing System (DailyMart) - Production Environment Template
# ===================================================================

# -------------------------------------------------------------------
# Backend (.NET 10 ASP.NET Core Web API - Port 5000)
# -------------------------------------------------------------------
ASPNETCORE_ENVIRONMENT=Production
ASPNETCORE_URLS=http://+:5000

# PostgreSQL Connection String (with Connection Pooling & Keepalive)
# Format: Host=localhost;Port=5432;Database=pos_billing_db;Username=postgres;Password=YOUR_SECRET;Maximum Pool Size=100;Minimum Pool Size=10;Connection Lifetime=300;
ConnectionStrings__DefaultConnection=Host=localhost;Port=5432;Database=pos_billing_db;Username=postgres;Password=root;Include Error Detail=false;Maximum Pool Size=100;Minimum Pool Size=10;Connection Lifetime=300;

# JWT Authentication
Jwt__Key=DailyMart_Super_Secure_JWT_Secret_Key_Production_2026_Minimum_32_Chars!
Jwt__Issuer=DailyMartPosApi
Jwt__Audience=DailyMartPosApp
Jwt__ExpiryMinutes=120
Jwt__RefreshTokenExpiryDays=7

# OpenWA Integration
OpenWA__Url=http://localhost:2785/api/v1
OpenWA__ApiKey=daily_mart_openwa_secret_2026
OpenWA__TimeoutSeconds=5

# CORS (Comma-delimited in environment or JSON array in appsettings)
Cors__AllowedOrigins__0=http://localhost:3000
Cors__AllowedOrigins__1=http://127.0.0.1:3000

# Initial Seed Credentials (used by Database Migrator)
SEED_ADMIN_EMAIL=admin@dailymart.in
SEED_ADMIN_PASSWORD=Admin@Pass123
SEED_CASHIER_EMAIL=cashier1@dailymart.in
SEED_CASHIER_PASSWORD=Cashier@Pass123

# -------------------------------------------------------------------
# POSUI (React 18 + Vite + MUI Frontend - Port 3000)
# -------------------------------------------------------------------
VITE_API_URL=http://localhost:5000
VITE_APP_NAME=DailyMart POS & Billing System
VITE_APP_VERSION=1.0.0

# -------------------------------------------------------------------
# OpenWA (Baileys WhatsApp Gateway - Port 2785)
# -------------------------------------------------------------------
PORT=2785
API_SECRET=daily_mart_openwa_secret_2026
WHATSAPP_SESSION_NAME=daily_mart_pos
AUTH_DIR=./auth_info_baileys

# -------------------------------------------------------------------
# Docker & Deployment Settings
# -------------------------------------------------------------------
DB_PASSWORD=root
JWT_SECRET=DailyMart_Super_Secure_JWT_Secret_Key_Production_2026_Minimum_32_Chars!
OPENWA_API_KEY=daily_mart_openwa_secret_2026
