# ===================================================================
# POS & Billing System - Environment Variables Template
# Copy this file to POSUI/.env and OpenWA/.env respectively.
# ===================================================================

# -------------------------------------------------------------------
# POSUI (React Frontend - Port 3000)
# -------------------------------------------------------------------
PORT=3000
REACT_APP_FIREBASE_API_KEY=AIzaSyYourFirebaseWebApiKeyPlaceholder
REACT_APP_FIREBASE_AUTH_DOMAIN=pos-billing-prod.firebaseapp.com
REACT_APP_FIREBASE_PROJECT_ID=pos-billing-prod
REACT_APP_FIREBASE_STORAGE_BUCKET=pos-billing-prod.appspot.com
REACT_APP_FIREBASE_MESSAGING_SENDER_ID=102938475610
REACT_APP_FIREBASE_APP_ID=1:102938475610:web:abcdef123456
REACT_APP_FIREBASE_MEASUREMENT_ID=G-MEASUREMENTID

# OpenWA WhatsApp Client Connection
REACT_APP_OPENWA_API_URL=http://localhost:2785/api/v1
REACT_APP_OPENWA_API_KEY=sample_openwa_client_token

# -------------------------------------------------------------------
# OpenWA (NestJS WhatsApp Gateway - Port 2785 / 2886)
# -------------------------------------------------------------------
OPENWA_PORT=2785
OPENWA_DASHBOARD_PORT=2886
OPENWA_API_SECRET=sample_openwa_server_secret_key
WHATSAPP_SESSION_NAME=pos_whatsapp_session
RATE_LIMIT_DELAY_MS=1500
